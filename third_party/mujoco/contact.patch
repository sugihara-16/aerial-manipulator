+// Check the EPA witness against the separating support plane in its direction.
+// This checks numerical consistency, not global optimality of the EPA result.
+static int consistentPenetration(const mjCCDStatus* status, const mjtNum direction[3],
+                                 mjCCDObj* obj1, mjCCDObj* obj2, mjtNum accuracy_tolerance) {
+  if (status->dist[0] >= 0) return 1;
+  mjtNum n[3], neg[3];
+  copy3(n, direction);
+  mjtNum length = norm3(n);
+  if (length < mjMINVAL) return 0;
+  scl3(n, n, 1 / length);
+  scl3(neg, n, -1);
+  Vertex v;
+  support(&v, obj1, obj2, n, neg);
+  mjtNum allowance = 4 * accuracy_tolerance;
+  mjtNum residual = dot3(v.vert, n) + status->dist[0];
+  mjtNum witness[3];
+  sub3(witness, status->x1, status->x2);
+  sub3(witness, witness, direction);
+  return norm3(witness) <= allowance
+      && residual >= -allowance && residual <= allowance;
+}
